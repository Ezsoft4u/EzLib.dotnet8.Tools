<?xml version="1.0"?>
<package>
  <metadata>
    <id>EzLib.dotnet8.Tools</id>
    <version>1.0.5</version>
    <title>EzLib .NET8 Library</title>
    <authors>MarkChu</authors>
    <owners>Ezsoft4u Studio Inc.</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <description>EzLib 是一個 .NET 8 公用工具程式庫，提供 Serilog 整合、郵件寄送服務（多收件人 / 附件 / Debug 支援）等功能。</description>
    <releaseNotes>1.0.5 - Internal maintenance (pack script automation).
1.0.4 - Enhanced MailService: multi-recipient (To/Cc/Bcc) parsing, Serilog Debug integration, attachment logging, improved error messages (includes InnerException), safe recipient override in DEBUG build.
1.0.0 - Initial release.</releaseNotes>
    <copyright>Copyright © 2025 Ezsoft4u Studio Inc.</copyright>
    <tags>utility tools serilog mail smtp logging dotnet8</tags>
    <readme>docs/readme.md</readme>
    <!-- 針對 .NET 8 的依賴項 -->
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.AspNetCore.Http.Features" version="5.0.17" />
        <dependency id="Serilog" version="4.0.1" />
        <dependency id="Serilog.AspNetCore" version="8.0.2" />
        <dependency id="Serilog.Sinks.Console" version="6.0.0" />
        <dependency id="Serilog.Sinks.File" version="6.0.0" />
        <dependency id="Serilog.Sinks.MSSqlServer" version="6.6.1" />
        <dependency id="MailKit" version="4.7.1.1" />
        <dependency id="MimeKit" version="4.7.1" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net8.0\EzLib.dll" target="lib\net8.0\" />
    <file src="bin\Release\net8.0\EzLib.pdb" target="lib\net8.0\" />
    <file src="docs\readme.md" target="docs\" />
  </files>
</package>